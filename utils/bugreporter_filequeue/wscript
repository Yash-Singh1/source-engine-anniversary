#! /usr/bin/env python
# encoding: utf-8

top = '.'
PROJECT_NAME = 'bugreporter_filequeue'

def options(opt):
	return

def configure(conf):
	conf.env.append_unique('DEFINES', ['BUGREPORTER_EXPORTS'])

def build(bld):
	includes = [
		'.',
		'../common',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../common',
	]

	bld.shlib(
		source   = ['bugreporter.cpp'],
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		use      = ['tier0', 'tier1', 'vstdlib', 'ICONV'],
		install_path = bld.env.LIBDIR,
		idx      = bld.get_taskgen_count()
	)
