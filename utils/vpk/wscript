#! /usr/bin/env python
# encoding: utf-8

top = '.'
PROJECT_NAME = 'vpk'

def options(opt):
	return

def configure(conf):
	return

def build(bld):
	includes = [
		'.',
		'../common',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../common',
	]

	# Retail's packtest (asserts on) inlines the Source SDK 2013 versions of these
	# tier1 containers: their Assert line numbers and SetSize/copy code.
	cxxflags = []
	if bld.env.RETAIL_OSX32:
		includes = ['sdk2013', 'sdk2013/tier1'] + includes
		cxxflags = bld.retail_macro_prefix_map('sdk2013', 'public')

	bld(
		source   = ['packtest.cpp'],
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx cxxprogram',
		includes = includes,
		cxxflags = cxxflags,
		use      = ['tier0', 'tier1', 'tier2', 'mathlib', 'vstdlib', 'vpklib', 'CRYPTOPP', 'ICONV'],
		retail_module = 'bin/vpk_osx32',
		install_path = bld.env.BINDIR,
		idx      = bld.get_taskgen_count()
	)
