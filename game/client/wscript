#! /usr/bin/env python
# encoding: utf-8

from waflib import Utils
import os
import vpc_parser

top = '.'
PROJECT_NAME = 'client'

def options(opt):
	return

games = {
	'hl2': ['client_base.vpc', 'client_hl2.vpc'],
	'hl2mp': ['client_base.vpc', 'client_hl2mp.vpc'],
	'hl1': ['client_base.vpc', 'client_hl1.vpc'],
	'episodic': ['client_base.vpc', 'client_episodic.vpc'],
	'portal': ['client_base.vpc', 'client_portal.vpc'],
	'hl1mp': ['client_base.vpc', 'client_hl1mp.vpc'],
	'cstrike': ['client_base.vpc', 'client_cstrike.vpc'],
	'dod': ['client_base.vpc', 'client_dod.vpc']
}

# --retail-osx32: retail hl2 is the episodic build (same objects and code),
# Lost Coast is the hl2 project. Sources come from the retail manifest.
retail_games = {
	'hl2': games['episodic'],
	'episodic': games['episodic'],
	'lostcoast': games['hl2'],
}

def configure(conf):
	game = conf.options.GAMES
	conf.env.GAMES = game

	if conf.env.RETAIL_OSX32 or conf.env.RETAIL_LINUX32:
		if game not in retail_games:
			conf.fatal("retail modes build only %s" % ', '.join(retail_games))
		return

	conf.env.append_unique('DEFINES', ['DISABLE_STEAM=1'])

	if game not in games.keys():
		conf.fatal("Couldn't find game: ", game)

def build(bld):
	retail = bld.env.RETAIL_OSX32 or bld.env.RETAIL_LINUX32
	game = vpc_parser.parse_vpcs( bld.env, (retail_games if retail else games)[bld.env.GAMES], '../..' )

	includes = [
		'.',
		'game_controls',
		'../../common',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../vgui2/include',
		'../../vgui2/controls',
		'../shared'
	]

	libs = [
		'tier0',
		'particles',
		'dmxloader',
		'vgui_controls',
		'matsys_controls',
		'tier1',
		'tier2',
		'tier3',
		'mathlib',
		'vstdlib',
		'choreoobjects',
		'steam_api',
		'bitmap',
		'vtf',
		'RT',
		'ZLIB',
		'JPEG',
		'PNG'
	]

	install_path = bld.env.PREFIX
	if bld.env.DEST_OS != 'android':
		install_path += '/'+bld.env.GAMES+'/bin'

	if bld.env.DEST_OS == 'win32':
		libs += ['USER32']

	# In retail mode the manifest (RETAIL_SELECT) replaces these with retail's file set.
	source = [ 'in_touch.cpp', '../../common/imageutils.cpp' ] + game["sources"] + ['../../public/tier0/memoverride.cpp']
	retail_module = '%s/%s' % (bld.env.GAMES, PROJECT_NAME) if retail else None
	includes += game["includes"]
	defines = game["defines"]

	defines.remove('PROTECTED_THINGS_ENABLE')
	archives = {}
	if retail and bld.env.GAMES == 'lostcoast':
		defines.append('HL2_LOSTCOAST')
		# Lost Coast links its own October 2024 builds of the static libraries
		for lib in ('tier1', 'tier2', 'tier3', 'mathlib', 'particles', 'dmxloader', 'choreoobjects', 'vgui_controls', 'matsys_controls', 'bitmap', 'vtf'):
			archives['lib%s.a' % lib] = bld.retail_stlib_variant(lib, '_lc', ['-DHL2_LOSTCOAST'])
		libs = [archives.get('lib%s.a' % u, u) for u in libs]

	if retail and retail_module:
		import retail_manifest
		retail_manifest.RETAIL_DEAD.setdefault(retail_module, [
			('common/language.cpp', 'common/randoverride.cpp'),
			('game/shared/debugoverlay_shared.cpp', 'game/shared/decals.cpp'),
			('game/shared/ehandle.cpp', 'game/shared/entitylist_base.cpp'),
			('game/shared/hintmessage.cpp', 'game/shared/hintsystem.cpp'),
			('game/shared/rope_helpers.cpp', 'game/shared/saverestore.cpp'),
			('game/shared/sheetsimulator.cpp', 'game/shared/singleplay_gamerules.cpp'),
			('public/bone_accessor.cpp', 'public/bone_setup.cpp'),
			('game/client/baseclientrendertargets.cpp', 'game/client/basepresence.cpp'),
			('game/client/hud_basetimer.cpp', 'game/client/hud_chat.cpp'),
			('game/client/hud_bitmapnumericdisplay.cpp', 'game/client/hud_chat.cpp'),
			('game/client/vgui_basepanel.cpp', 'game/client/vgui_bitmapbutton.cpp'),
		])
		retail_manifest.RETAIL_STLIB_BEFORE.setdefault(retail_module, [
			('jpeg', 'tier1'),
			('png', 'vgui_controls'),
		])

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		install_path = install_path,
		retail_module = retail_module,
		retail_archives = archives,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)

