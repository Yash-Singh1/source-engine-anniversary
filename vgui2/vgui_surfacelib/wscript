from waflib import Utils
import os

top = '.'
PROJECT_NAME = 'vgui_surfacelib'

def options(opt):
	# stub
	return

def configure(conf):
	return

def build(bld):
	source = [
		'BitmapFont.cpp',
		'FontAmalgam.cpp',
		'FontManager.cpp',
		'FontEffects.cpp',
		#'Win32Font_x360.cpp',	[$X360]
		#'osxfont.cpp',			[$OSXALL]
	]
	
	if bld.env.DEST_OS == 'win32':
		source += [
			'Win32Font.cpp'
		]
	elif bld.env.RETAIL_OSX32:
		source += ['osxfont.cpp']
	else:
		source += [
			'linuxfont.cpp'
		]

	includes = [
		'.',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../common',
	] + bld.env.INCLUDES_FC + bld.env.INCLUDES_FT2 + bld.env.INCLUDES_SDL2

	defines = []

	libs = []

	bld.stlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)
