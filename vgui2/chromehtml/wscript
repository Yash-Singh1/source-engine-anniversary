def build(bld):
	# Built like Chromium's own targets: no RTTI or exceptions (the retail
	# wrapper's vtables have no typeinfo).
	bld.stlib(
		source   = CEF_WRAPPER_SOURCES,
		target   = 'cef_dll_wrapper',
		name     = 'cef_dll_wrapper',
		features = 'cxx',
		includes = ['../../external/cef'],
		defines  = ['USING_CEF_SHARED'],
		cxxflags = ['-fno-rtti', '-fno-exceptions'],
		idx      = bld.get_taskgen_count()
	)

	# generated_proto/htmlmessages.pb.* come from htmlmessages.proto with protoc 2.3.0:
	#   protoc --proto_path=. --cpp_out=generated_proto htmlmessages.proto
	source = [
		'../../common/jpegloader.cpp',
		'../../common/jpegloader_common.cpp',
		'../../public/html/htmlprotobuf.cpp',
		'../../tier1/fileio.cpp',
		'chromewrapper.cpp',
		'generated_proto/htmlmessages.pb.cc',
		'html_chrome.cpp',
		'html_mac.mm',
	]

	includes = [
		'.',
		'generated_proto',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../common',
		'../../public/jpeglib',
		'../../external',
		'../../external/cef',
	]

	defines = []

	libs = ['tier0','tier1','vstdlib','JPEG','PNG','PROTOBUF','ZLIB','cef_dll_wrapper']

	install_path = bld.env.LIBDIR

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		install_path = install_path,
		idx      = bld.get_taskgen_count()
	)
