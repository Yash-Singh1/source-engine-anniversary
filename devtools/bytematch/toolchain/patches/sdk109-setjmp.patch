MacOSX10.9.sdk declares longjmp, _longjmp and siglongjmp __dead2 (Apple Libc
825+, OS X 10.8); the 10.6 i386 headers the stub SDK reuses don't. Without it
clang can't infer that a function ending in longjmp never returns, which
changes codegen at its call sites (vstdlib's Coroutine_Finish callers).
Applied by make-sdk109.py.

--- a/usr/include/i386/setjmp.h
+++ b/usr/include/i386/setjmp.h
@@ -64,13 +64,13 @@
 
 __BEGIN_DECLS
 int	setjmp(jmp_buf);
-void	longjmp(jmp_buf, int);
+void	longjmp(jmp_buf, int) __dead2;
 
 #ifndef _ANSI_SOURCE
 int	_setjmp(jmp_buf);
-void	_longjmp(jmp_buf, int);
+void	_longjmp(jmp_buf, int) __dead2;
 int	sigsetjmp(sigjmp_buf, int);
-void	siglongjmp(sigjmp_buf, int);
+void	siglongjmp(sigjmp_buf, int) __dead2;
 #endif /* _ANSI_SOURCE  */
 
 #if !defined(_ANSI_SOURCE) && (!defined(_POSIX_C_SOURCE) || defined(_DARWIN_C_SOURCE))
