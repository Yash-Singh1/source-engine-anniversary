#!/usr/bin/env python3
"""Launcher: prefers the tool's own venv (devtools/bytematch/.venv) when present."""
import os
import sys

here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
venv_py = os.path.join(here, '.venv', 'bin', 'python3')
if os.path.exists(venv_py) and os.path.realpath(sys.prefix) != os.path.realpath(os.path.join(here, '.venv')):
    os.execv(venv_py, [venv_py, os.path.realpath(__file__)] + sys.argv[1:])
sys.path.insert(0, here)

from bytematch.cli import main  # noqa: E402

sys.exit(main())
